# ---------- Local Postgres (Docker) ----------
POSTGRES_DB=smb_ai_suite
POSTGRES_USER=suite_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg2://suite_user:change_me@localhost:5434/smb_ai_suite

# ---------- llama.cpp (native Windows host, same as job-market-pipeline) ----------
LLAMACPP_EMBEDDING_URL=http://localhost:8090
LLAMACPP_GENERATION_URL=http://localhost:8091
EMBEDDING_DIM=768

# ---------- Cloud snapshot (Neon free tier) — for the PUBLIC portfolio app ----------
# Separate free Neon project. Same table names/prefixes as local, no pgvector needed there.
NEON_DATABASE_URL=

# ---------- App behavior ----------
MAX_CRITIC_RETRIES=2
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
TOP_K_RETRIEVAL=6
